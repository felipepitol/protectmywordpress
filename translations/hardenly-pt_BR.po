#. Plugin Name of the plugin
#: hardenly.php
msgid "Hardenly"
msgstr "Hardenly – Proteção e Hardening de Segurança"

#. Plugin URI of the plugin
#: hardenly.php
msgid "https://github.com/felipepitol/protectmywordpress"
msgstr ""

#. Description of the plugin
#: hardenly.php
msgid ""
"Turn on common security hardening measures with simple switches: block PHP "
"in uploads, disable XML-RPC, stop user enumeration, hide the version and "
"more."
msgstr ""
"Ative medidas comuns de hardening de segurança com chaves simples: bloqueie "
"PHP em uploads, desative o XML-RPC, impeça a enumeração de usuários, oculte "
"a versão e mais."

#. Author of the plugin
#: hardenly.php
msgid "Felipe Pitol"
msgstr ""

#. Author URI of the plugin
#: hardenly.php
msgid "https://felipepitol.me"
msgstr ""

#: includes/class-hardenly-admin.php:60
msgid ""
"Hardenly replaces ProtectMyWordPress and has already imported its settings. "
"Please deactivate and delete ProtectMyWordPress."
msgstr ""
"O Hardenly substitui o ProtectMyWordPress e já importou as configurações "
"dele. Desative e exclua o ProtectMyWordPress."

#: includes/class-hardenly-admin.php:72
msgid "Hardenly Settings"
msgstr "Configurações do Hardenly"

#: includes/class-hardenly-admin.php:91
msgid "Settings"
msgstr "Configurações"

#: includes/class-hardenly-admin.php:157
msgid "Could not check the module status."
msgstr "Não foi possível verificar o status dos módulos."

#: includes/class-hardenly-admin.php:158
msgid "Could not reach the server."
msgstr "Não foi possível falar com o servidor."

#: includes/class-hardenly-admin.php:159
msgid "Checking…"
msgstr "Verificando…"

#: includes/class-hardenly-admin.php:160
msgid "You have unsaved changes."
msgstr "Há alterações não salvas."

#: includes/class-hardenly-admin.php:161
msgid "Working"
msgstr "Funcionando"

#: includes/class-hardenly-admin.php:162
msgid "Off"
msgstr "Desligado"

#: includes/class-hardenly-admin.php:163
msgid "Problem"
msgstr "Problema"

#. translators: 1: number of protections working, 2: number of protections with a problem.
#: includes/class-hardenly-admin.php:165
#, php-format
msgid "%1$s working, %2$s with a problem."
msgstr "%1$s funcionando, %2$s com problema."

#. translators: %s: number of protections working.
#: includes/class-hardenly-admin.php:167
#, php-format
msgid "All %s active protections are working."
msgstr "Todas as %s proteções ativas estão funcionando."

#: includes/class-hardenly-admin.php:181
msgid "Disable registration"
msgstr "Desativar cadastro"

#: includes/class-hardenly-admin.php:182
msgid "Prevents new user registrations."
msgstr "Impede o registro de novos usuários."

#: includes/class-hardenly-admin.php:185
msgid "Disable file editors"
msgstr "Desativar editores de arquivos"

#: includes/class-hardenly-admin.php:186
msgid "Disables theme and plugin file editing in the dashboard."
msgstr "Desativa a edição de arquivos de temas e plugins pelo painel."

#: includes/class-hardenly-admin.php:189
msgid "Block PHP in uploads"
msgstr "Bloquear PHP em uploads"

#: includes/class-hardenly-admin.php:190
msgid ""
"Adds .htaccess rules that block PHP files in the uploads folder (Apache and "
"LiteSpeed)."
msgstr ""
"Adiciona regras ao .htaccess que bloqueiam arquivos PHP na pasta uploads "
"(Apache e LiteSpeed)."

#: includes/class-hardenly-admin.php:193
msgid "Hide version number"
msgstr "Ocultar número da versão"

#: includes/class-hardenly-admin.php:194
msgid "Removes the WordPress version from the page head and feeds."
msgstr "Remove a versão do WordPress do head da página e dos feeds."

#: includes/class-hardenly-admin.php:197
msgid "Generic login errors"
msgstr "Erros de login genéricos"

#: includes/class-hardenly-admin.php:198
msgid ""
"Shows a generic message when a login fails, without saying whether the "
"username exists."
msgstr ""
"Exibe uma mensagem genérica quando o login falha, sem dizer se o usuário "
"existe."

#: includes/class-hardenly-admin.php:201
msgid "Disable directory listing"
msgstr "Desativar listagem de diretórios"

#: includes/class-hardenly-admin.php:202
msgid ""
"Adds an empty index.php to the uploads folder so its files cannot be listed."
msgstr ""
"Adiciona um index.php vazio à pasta uploads para que os arquivos não possam "
"ser listados."

#: includes/class-hardenly-admin.php:205
msgid "Prevent user enumeration"
msgstr "Impedir enumeração de usuários"

#: includes/class-hardenly-admin.php:206
msgid ""
"Hides usernames from ?author=N, the REST API, the users sitemap and oEmbed."
msgstr ""
"Oculta os nomes de usuário do ?author=N, da REST API, do sitemap de usuários "
"e do oEmbed."

#: includes/class-hardenly-admin.php:209
msgid "Remove X-Powered-By header"
msgstr "Remover cabeçalho X-Powered-By"

#: includes/class-hardenly-admin.php:210
msgid "Removes the header that reveals the PHP version."
msgstr "Remove o header que revela a versão do PHP."

#: includes/class-hardenly-admin.php:213
msgid "Block the \"admin\" username"
msgstr "Bloquear o nome de usuário \"admin\""

#: includes/class-hardenly-admin.php:214
msgid "Blocks new registrations that use the username \"admin\"."
msgstr "Bloqueia novos registros que usam o nome de usuário \"admin\"."

#: includes/class-hardenly-admin.php:217
msgid "Disable XML-RPC"
msgstr "Desabilitar XML-RPC"

#: includes/class-hardenly-admin.php:218
msgid ""
"Turns off XML-RPC, including pingbacks, and removes the X-Pingback header."
msgstr "Desativa o XML-RPC, inclusive pingbacks, e remove o header X-Pingback."

#: includes/class-hardenly-admin.php:221
msgid "Require a display name other than the username"
msgstr "Exigir nome de exibição diferente do usuário"

#: includes/class-hardenly-admin.php:222
msgid ""
"Prevents users from saving a profile whose public display name is their "
"username."
msgstr ""
"Impede que usuários salvem um perfil cujo nome de exibição público seja o "
"próprio login."

#: includes/class-hardenly-admin.php:236
msgid "Accounts and login"
msgstr "Contas e login"

#: includes/class-hardenly-admin.php:237
msgid "Make it harder to guess usernames or create accounts on this site."
msgstr "Dificulta adivinhar nomes de usuário ou criar contas neste site."

#: includes/class-hardenly-admin.php:241
msgid "Files and uploads"
msgstr "Arquivos e uploads"

#: includes/class-hardenly-admin.php:242
msgid "Stop uploaded or edited files from being used to run code."
msgstr "Impede que arquivos enviados ou editados sejam usados para executar código."

#: includes/class-hardenly-admin.php:246
msgid "Server details"
msgstr "Detalhes do servidor"

#: includes/class-hardenly-admin.php:247
msgid "Hide the software versions that attackers use to pick known exploits."
msgstr "Oculta as versões de software que atacantes usam para escolher falhas conhecidas."

#: includes/class-hardenly-admin.php:251
msgid "Remote access"
msgstr "Acesso remoto"

#: includes/class-hardenly-admin.php:252
msgid ""
"Close an old remote publishing interface that is often used for brute-force "
"attacks."
msgstr "Fecha uma interface antiga de publicação remota muito usada em ataques de força bruta."

#: includes/class-hardenly-admin.php:275
msgid "Hardenly"
msgstr "Hardenly"

#: includes/class-hardenly-admin.php:276
msgid ""
"Turn on the protections you want for this site. Changes apply as soon as you "
"save."
msgstr "Ative as proteções que você quer neste site. As alterações valem assim que você salvar."

#. translators: 1: number of protections turned on, 2: total number of protections.
#: includes/class-hardenly-admin.php:283
#, php-format
msgid "%1$s of %2$s protections on"
msgstr "%1$s de %2$s proteções ativas"

#: includes/class-hardenly-admin.php:329
msgid "Save changes"
msgstr "Salvar alterações"

#: includes/class-hardenly-admin.php:331
msgid "Check status"
msgstr "Verificar status"

#. translators: %s: plugin version number.
#: includes/class-hardenly-admin.php:337
#, php-format
msgid "Version %s"
msgstr "Versão %s"

#: includes/class-hardenly-security.php:280
msgid ""
"Hardenly could not write the protection rules to .htaccess in the uploads "
"folder. Please check the file permissions."
msgstr ""
"O Hardenly não conseguiu gravar as regras de proteção no .htaccess da pasta "
"uploads. Verifique as permissões."

#: includes/class-hardenly-security.php:284
msgid ""
"Hardenly could not create index.php in the uploads folder. Please check the "
"file permissions."
msgstr ""
"O Hardenly não conseguiu criar o index.php na pasta uploads. Verifique as "
"permissões."

#: includes/class-hardenly-security.php:378
msgid "Login failed."
msgstr "Login falhou."

#: includes/class-hardenly-security.php:405
msgid "The username \"admin\" is not allowed."
msgstr "O nome de usuário \"admin\" não é permitido."

#: includes/class-hardenly-security.php:430
msgid "Your public display name cannot be the same as your username."
msgstr ""
"Seu nome de exibição público não pode ser igual ao seu nome de usuário."

#: includes/class-hardenly-security.php:459
msgid "Error: users_can_register is enabled."
msgstr "Erro: users_can_register está ativado."

#: includes/class-hardenly-security.php:463
msgid "Error: DISALLOW_FILE_EDIT is not defined."
msgstr "Erro: DISALLOW_FILE_EDIT não está definido."

#: includes/class-hardenly-security.php:468
msgid ""
"Error: the protection rules are missing from .htaccess in the uploads folder."
msgstr "Erro: as regras de proteção não estão no .htaccess da pasta uploads."

#: includes/class-hardenly-security.php:472
msgid "Error: index.php does not exist in the uploads folder."
msgstr "Erro: index.php não existe na pasta uploads."

#: includes/class-hardenly-security.php:478
msgid "Error: XML-RPC is enabled."
msgstr "Erro: XML-RPC está ativado."

#: includes/class-hardenly-security.php:482
msgid "Error: wp_generator is still active."
msgstr "Erro: wp_generator ainda está ativo."

#: includes/class-hardenly-security.php:489
msgid "Module disabled."
msgstr "Módulo desativado."

#: includes/class-hardenly-security.php:494
msgid "Active."
msgstr "Ativo."

#: includes/functions.php:92
msgid "Access denied."
msgstr "Acesso negado."
