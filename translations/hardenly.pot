#: includes/class-hardenly-admin.php:181
msgid "Disable registration"
msgstr ""

#: includes/class-hardenly-admin.php:182
msgid "Prevents new user registrations."
msgstr ""

#: includes/class-hardenly-admin.php:185
msgid "Disable file editors"
msgstr ""

#: includes/class-hardenly-admin.php:186
msgid "Disables theme and plugin file editing in the dashboard."
msgstr ""

#: includes/class-hardenly-admin.php:189
msgid "Block PHP in uploads"
msgstr ""

#: includes/class-hardenly-admin.php:190
msgid "Adds .htaccess rules that block PHP files in the uploads folder (Apache and LiteSpeed)."
msgstr ""

#: includes/class-hardenly-admin.php:193
msgid "Hide version number"
msgstr ""

#: includes/class-hardenly-admin.php:194
msgid "Removes the WordPress version from the page head and feeds."
msgstr ""

#: includes/class-hardenly-admin.php:197
msgid "Generic login errors"
msgstr ""

#: includes/class-hardenly-admin.php:198
msgid "Shows a generic message when a login fails, without saying whether the username exists."
msgstr ""

#: includes/class-hardenly-admin.php:201
msgid "Disable directory listing"
msgstr ""

#: includes/class-hardenly-admin.php:202
msgid "Adds an empty index.php to the uploads folder so its files cannot be listed."
msgstr ""

#: includes/class-hardenly-admin.php:205
msgid "Prevent user enumeration"
msgstr ""

#: includes/class-hardenly-admin.php:206
msgid "Hides usernames from ?author=N, the REST API, the users sitemap and oEmbed."
msgstr ""

#: includes/class-hardenly-admin.php:209
msgid "Remove X-Powered-By header"
msgstr ""

#: includes/class-hardenly-admin.php:210
msgid "Removes the header that reveals the PHP version."
msgstr ""

#: includes/class-hardenly-admin.php:213
msgid "Block the \"admin\" username"
msgstr ""

#: includes/class-hardenly-admin.php:214
msgid "Blocks new registrations that use the username \"admin\"."
msgstr ""

#: includes/class-hardenly-admin.php:217
msgid "Disable XML-RPC"
msgstr ""

#: includes/class-hardenly-admin.php:218
msgid "Turns off XML-RPC, including pingbacks, and removes the X-Pingback header."
msgstr ""

#: includes/class-hardenly-admin.php:221
msgid "Require a display name other than the username"
msgstr ""

#: includes/class-hardenly-admin.php:222
msgid "Prevents users from saving a profile whose public display name is their username."
msgstr ""

#: includes/class-hardenly-admin.php:236
msgid "Accounts and login"
msgstr ""

#: includes/class-hardenly-admin.php:237
msgid "Make it harder to guess usernames or create accounts on this site."
msgstr ""

#: includes/class-hardenly-admin.php:241
msgid "Files and uploads"
msgstr ""

#: includes/class-hardenly-admin.php:242
msgid "Stop uploaded or edited files from being used to run code."
msgstr ""

#: includes/class-hardenly-admin.php:246
msgid "Server details"
msgstr ""

#: includes/class-hardenly-admin.php:247
msgid "Hide the software versions that attackers use to pick known exploits."
msgstr ""

#: includes/class-hardenly-admin.php:251
msgid "Remote access"
msgstr ""

#: includes/class-hardenly-admin.php:252
msgid "Close an old remote publishing interface that is often used for brute-force attacks."
msgstr ""

